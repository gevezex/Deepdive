{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Alleen het hoofdvenster, met lokale inhoud. Verborgen vensters, inlogvensters en pagina's van internet krijgen niets.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-url",
    "allow-import-pdf",
    "allow-save-pdf-text",
    "allow-read-pdf",
    "allow-import-text",
    "allow-list-sources",
    "allow-get-source",
    "allow-refetch-source",
    "allow-adopt-candidate",
    "allow-discard-candidate",
    "allow-accept-incomplete",
    "allow-site-login-open",
    "allow-site-login-close",
    "allow-list-site-sessions",
    "allow-wipe-site-session",
    "allow-list-providers",
    "allow-save-provider",
    "allow-delete-provider",
    "allow-save-model",
    "allow-delete-model",
    "allow-refresh-models",
    "allow-select-model",
    "allow-test-connection",
    "allow-chatgpt-login",
    "allow-chatgpt-cancel-login",
    "allow-chatgpt-logout",
    "allow-chatgpt-welcome-seen",
    "allow-open-chatgpt-usage",
    "allow-generate-blueprint",
    "allow-cancel-blueprint",
    "allow-saved-blueprints"
  ]
}
